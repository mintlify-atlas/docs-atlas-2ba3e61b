  "keyFeatures": [
    "Plugin loading system with dependency resolution and load order management",
    "Preloader assembly patcher system for modifying game assemblies before load",
    "Persistent INI-based configuration API with type-safe bindings",
    "Structured logging system with pluggable listeners (console, disk, custom)",
    "Support for Unity Mono, Unity IL2CPP, and .NET/XNA game runtimes",
    "Cross-platform support (Windows, Linux, macOS)",
    "Doorstop-based injection requiring no game file modification",
    "HarmonyX integration for method patching"
  ],
